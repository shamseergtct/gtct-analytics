@REM =============================================================================
@REM GTCT Restaurant — Windows PILOT environment (copy to env.pilot.cmd)
@REM =============================================================================
@REM Operating mode stays TEST. Real PRODUCTION mode is NOT implemented and will
@REM refuse to start. This pilot uses a dedicated local data folder, not the
@REM reserved production vault and not any development Mac database.
@REM
@REM Physical printing stays OFF until an authorized person edits this file and
@REM sets GTCT_ENABLE_PHYSICAL_PRINT=true AFTER a successful manual test print.
@REM =============================================================================

set "GTCT_OPERATING_MODE=TEST"
set "GTCT_LOCAL_HOST=127.0.0.1"
set "GTCT_LOCAL_PORT=8787"

@REM Dedicated pilot database (outside source tree). Persistent across restarts.
set "GTCT_LOCAL_DATA_DIR=%LOCALAPPDATA%\GTCT\RestaurantPilot"

@REM SQLite-safe backups (must be a separate absolute folder — never the data dir).
set "GTCT_TEST_BACKUP_DIR=%LOCALAPPDATA%\GTCT\RestaurantPilot-Backups"

@REM Optional restore target for non-destructive restore drills only.
set "GTCT_TEST_RESTORE_DIR=%LOCALAPPDATA%\GTCT\RestaurantPilot-Restore"

@REM Physical LAN/spooler printing — keep false until authorized on this PC.
set "GTCT_ENABLE_PHYSICAL_PRINT=false"

@REM Do not enable LAN listener / HTTPS multi-PC access without separate approval.
set "GTCT_ALLOW_LAN_BIND=false"
set "GTCT_ENABLE_LAN_LISTENER=false"

@REM Dev bearer tokens stay off for pilot.
set "GTCT_ALLOW_DEV_TOKEN=false"
