rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profileExists() {
      return signedIn() && exists(userPath());
    }

    function profile() {
      return get(userPath()).data;
    }

    function activeUser() {
      return profileExists() && profile().isActive != false;
    }

    function isSuperAdmin() {
      return activeUser() && profile().role == 'super_admin';
    }

    function assignedTo(clientId) {
      return activeUser()
        && profile().assignedShops is list
        && profile().assignedShops.hasAny([clientId]);
    }

    function canAccessClient(clientId) {
      return isSuperAdmin() || assignedTo(clientId);
    }

    function isShopAdmin() {
      return activeUser() && profile().role == 'shop_admin';
    }

    function canManageClient(clientId) {
      return isSuperAdmin()
        || (
          (profile().role == 'admin' || isShopAdmin())
          && assignedTo(clientId)
        );
    }

    function isDeliveryBoy() {
      return activeUser() && profile().role == 'delivery_boy';
    }

    function isStaff() {
      return activeUser() && profile().role == 'staff';
    }

    function isStaffForClient(clientId) {
      return isStaff() && assignedTo(clientId);
    }

    /** Staff checklist + admin/super_admin for the same shop. */
    function canReviewInventoryDaily(clientId) {
      return canManageClient(clientId) || isStaffForClient(clientId);
    }

    function isDeliveryBoyForClient(clientId) {
      return isDeliveryBoy()
        && assignedTo(clientId)
        && profile().deliveryBoyId is string
        && profile().deliveryBoyId.size() > 0;
    }

    function clientSettingsPath(clientId) {
      return /databases/$(database)/documents/client_settings/$(clientId);
    }

    function shiftDocPath(shiftId) {
      return /databases/$(database)/documents/shifts/$(shiftId);
    }

    function hasOpenOperationsShift(clientId) {
      return exists(clientSettingsPath(clientId))
        && get(clientSettingsPath(clientId)).data.keys().hasAny(['operationsShiftId'])
        && get(clientSettingsPath(clientId)).data.operationsShiftId is string
        && get(clientSettingsPath(clientId)).data.operationsShiftId.size() > 0
        && exists(shiftDocPath(get(clientSettingsPath(clientId)).data.operationsShiftId))
        && get(shiftDocPath(get(clientSettingsPath(clientId)).data.operationsShiftId)).data.status == 'OPEN'
        && get(shiftDocPath(get(clientSettingsPath(clientId)).data.operationsShiftId)).data.clientId == clientId;
    }

    function operationsShiftData(clientId) {
      return get(shiftDocPath(get(clientSettingsPath(clientId)).data.operationsShiftId)).data;
    }

    /** UID of shop_admin bound to the OPEN operations shift, else ''. */
    function shopAdminOpsOwnerUid(clientId) {
      return !hasOpenOperationsShift(clientId)
        ? ''
        : (
            operationsShiftData(clientId).keys().hasAny(['operationsBoundByRole'])
            && operationsShiftData(clientId).operationsBoundByRole == 'shop_admin'
            && operationsShiftData(clientId).operationsBoundBy is string
              ? operationsShiftData(clientId).operationsBoundBy
              : (
                  operationsShiftData(clientId).openedByRole == 'shop_admin'
                  && operationsShiftData(clientId).openedBy is string
                    ? operationsShiftData(clientId).openedBy
                    : ''
                )
          );
    }

    function isCurrentOperationsShift(shiftId, clientId) {
      return hasOpenOperationsShift(clientId)
        && get(clientSettingsPath(clientId)).data.operationsShiftId == shiftId;
    }

    function operationsShiftIdUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['operationsShiftId']);
    }

    function operationsShiftIdCleared() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['operationsShiftId'])
        && !(
          request.resource.data.keys().hasAny(['operationsShiftId'])
          && request.resource.data.operationsShiftId is string
          && request.resource.data.operationsShiftId.size() > 0
        );
    }

    function operationsShiftIdSetTo(clientId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['operationsShiftId'])
        && request.resource.data.keys().hasAny(['operationsShiftId'])
        && request.resource.data.operationsShiftId is string
        && request.resource.data.operationsShiftId.size() > 0
        && exists(shiftDocPath(request.resource.data.operationsShiftId))
        && get(shiftDocPath(request.resource.data.operationsShiftId)).data.clientId == clientId
        && get(shiftDocPath(request.resource.data.operationsShiftId)).data.status == 'OPEN';
    }

    /**
     * operationsShiftId changes:
     * - Clear: any canManageClient (close path).
     * - Set: shop_admin may claim unless another shop_admin owns open ops;
     *   admin/super_admin may set only when no other shop_admin owns open ops
     *   (or setting the same id).
     */
    function canChangeOperationsShiftId(clientId) {
      return operationsShiftIdUnchanged()
        || (
          canManageClient(clientId)
          && (
            operationsShiftIdCleared()
            || (
              operationsShiftIdSetTo(clientId)
              && (
                shopAdminOpsOwnerUid(clientId) == ''
                || shopAdminOpsOwnerUid(clientId) == request.auth.uid
                || (
                  resource.data.keys().hasAny(['operationsShiftId'])
                  && resource.data.operationsShiftId == request.resource.data.operationsShiftId
                )
              )
            )
          )
        );
    }

    /** businessDate on the operations shift cannot be moved. */
    function shiftBusinessDateChangeAllowed(shiftId, clientId) {
      return request.resource.data.businessDate == resource.data.businessDate
        || !isCurrentOperationsShift(shiftId, clientId);
    }

    /** Shop admin may not change businessDate on any OPEN shift. */
    function shopAdminShiftDateImmutable() {
      return !(
        isShopAdmin()
        && resource.data.status == 'OPEN'
        && request.resource.data.businessDate != resource.data.businessDate
      );
    }

    /** Terminal allowed via users profile or delivery_boys master assignment. */
    function deliveryBoyMayUseTerminal(terminalId) {
      return (
          profile().assignedTerminalIds is list
          && profile().assignedTerminalIds.hasAny([terminalId])
        )
        || (
          exists(/databases/$(database)/documents/delivery_boys/$(profile().deliveryBoyId))
          && get(/databases/$(database)/documents/delivery_boys/$(profile().deliveryBoyId)).data.assignedTerminalIds is list
          && get(/databases/$(database)/documents/delivery_boys/$(profile().deliveryBoyId)).data.assignedTerminalIds.hasAny([terminalId])
        );
    }

    /** Delivery Entry may only create pending submissions — not live bills. */
    function deliveryBoyOwnsSubmission() {
      return isDeliveryBoyForClient(request.resource.data.clientId)
        && request.resource.data.deliveryBoyId == profile().deliveryBoyId
        && request.resource.data.saleType == 'DELIVERY'
        && request.resource.data.status == 'PENDING'
        && request.resource.data.entryLocalId is string
        && request.resource.data.entryLocalId.size() > 0
        && deliveryBoyMayUseTerminal(request.resource.data.terminalId);
    }

    function validDeliveryBillSubmissionFields() {
      return request.resource.data.businessDate is string
        && request.resource.data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.terminalId is string
        && request.resource.data.terminalId.size() > 0
        && request.resource.data.billNumber is string
        && request.resource.data.billNumber.size() > 0
        && request.resource.data.billNumber.size() <= 40
        && request.resource.data.billAmount is number
        && request.resource.data.deliveryCharge is number
        && request.resource.data.deliveryCharge >= 0
        && request.resource.data.paymentMode in ['CASH', 'BANK', 'DELIVERY_ACCOUNT']
        && request.resource.data.status in ['PENDING', 'EDITED_PENDING', 'APPROVED', 'REJECTED'];
    }

    /** Delivery boy may edit own pending / approved bills (re-check via EDITED_PENDING). */
    function deliveryBoyMayEditOwnSubmission() {
      return isDeliveryBoyForClient(resource.data.clientId)
        && resource.data.deliveryBoyId == profile().deliveryBoyId
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.deliveryBoyId == resource.data.deliveryBoyId
        && request.resource.data.entryLocalId == resource.data.entryLocalId
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.saleType == 'DELIVERY'
        && validDeliveryBillSubmissionFields()
        && resource.data.status in ['PENDING', 'APPROVED', 'EDITED_PENDING']
        && (
          (
            resource.data.status == 'PENDING'
            && request.resource.data.status == 'PENDING'
          )
          || (
            resource.data.status in ['APPROVED', 'EDITED_PENDING']
            && request.resource.data.status == 'EDITED_PENDING'
            && request.resource.data.businessDate == resource.data.businessDate
            && request.resource.data.terminalId == resource.data.terminalId
            && request.resource.data.billNumber == resource.data.billNumber
          )
        );
    }

    /** Bank payments must reference an OPERATIONAL account for the same shop. */
    function externalBillBankIsOperational() {
      return request.resource.data.bankAccountId == ''
        || (
          exists(/databases/$(database)/documents/bank_accounts/$(request.resource.data.bankAccountId))
          && get(/databases/$(database)/documents/bank_accounts/$(request.resource.data.bankAccountId)).data.clientId
            == request.resource.data.clientId
          && get(/databases/$(database)/documents/bank_accounts/$(request.resource.data.bankAccountId)).data.isActive != false
          && (
            !('accountType' in get(/databases/$(database)/documents/bank_accounts/$(request.resource.data.bankAccountId)).data)
            || get(/databases/$(database)/documents/bank_accounts/$(request.resource.data.bankAccountId)).data.accountType != 'RESERVE'
          )
        );
    }

    function canReadTenantResource() {
      return canAccessClient(resource.data.clientId);
    }

    function canCreateTenantResource() {
      return request.resource.data.clientId is string
        && canAccessClient(request.resource.data.clientId)
        // Staff may only write inventory_daily_reviews (separate rules).
        && !isStaff();
    }

    function canUpdateTenantResource() {
      return canAccessClient(resource.data.clientId)
        && request.resource.data.clientId == resource.data.clientId
        && !isStaff();
    }

    function validDailyReviewAttentionStatus(status) {
      return status in ['ENOUGH', 'LOW', 'URGENT', 'VERY_URGENT'];
    }

    function validDailyReviewParentCreate() {
      return request.resource.data.keys().hasAll([
          'clientId',
          'businessDate',
          'status',
          'createdAt',
          'createdAtMs',
          'createdBy',
          'updatedAt',
          'updatedAtMs',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'clientId',
          'businessDate',
          'status',
          'createdAt',
          'createdAtMs',
          'createdBy',
          'updatedAt',
          'updatedAtMs',
          'updatedBy'
        ])
        && request.resource.data.clientId is string
        && request.resource.data.businessDate is string
        && request.resource.data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.status == 'OPEN'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAtMs is number
        && request.resource.data.updatedAtMs is number;
    }

    function validDailyReviewParentUpdate() {
      return request.resource.data.clientId == resource.data.clientId
        && request.resource.data.businessDate == resource.data.businessDate
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAtMs == resource.data.createdAtMs
        && request.resource.data.status in ['OPEN', 'COMPLETED']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAtMs is number;
    }

    function validDailyReviewLineWrite(reviewClientId, reviewBusinessDate, lineId) {
      return request.resource.data.keys().hasAll([
          'clientId',
          'businessDate',
          'itemId',
          'itemCode',
          'itemName',
          'stockSnapshot',
          'attentionStatus',
          'requestedQty',
          'notes',
          'completed',
          'reviewedBy',
          'reviewedByName',
          'reviewedAtMs',
          'updatedAt',
          'updatedAtMs',
          'updatedBy'
        ])
        && request.resource.data.clientId == reviewClientId
        && request.resource.data.businessDate == reviewBusinessDate
        && request.resource.data.itemId == lineId
        && request.resource.data.itemCode is string
        && request.resource.data.itemName is string
        && request.resource.data.stockSnapshot is number
        && validDailyReviewAttentionStatus(request.resource.data.attentionStatus)
        && (
          (
            request.resource.data.attentionStatus == 'ENOUGH'
            && (
              request.resource.data.requestedQty == null
              || (
                request.resource.data.requestedQty is number
                && request.resource.data.requestedQty >= 0
                && request.resource.data.requestedQty <= 1000000
              )
            )
          )
          || (
            request.resource.data.attentionStatus != 'ENOUGH'
            && request.resource.data.requestedQty is number
            && request.resource.data.requestedQty > 0
            && request.resource.data.requestedQty <= 1000000
          )
        )
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.completed == true
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedByName is string
        && request.resource.data.reviewedAtMs is number
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAtMs is number;
    }

    function purchasePartyBelongsToClient(partyId, clientId) {
      return (
          exists(/databases/$(database)/documents/parties/$(partyId))
          && get(/databases/$(database)/documents/parties/$(partyId)).data.clientId
            == clientId
        )
        || (
          exists(/databases/$(database)/documents/delivery_boys/$(partyId))
          && get(/databases/$(database)/documents/delivery_boys/$(partyId)).data.clientId
            == clientId
        );
    }

    function validPurchaseValues(data) {
      return data.amount is number
        && data.amount > 0
        && data.partyId is string
        && data.vendorName is string
        && data.receiptNote is string
        && data.entryType in ['purchase', 'expense']
        && (
          (
            data.entryType == 'purchase'
            && data.category in ['COMMODITY', 'CONSUMABLES', 'ASSET']
          )
          || (
            data.entryType == 'expense'
            && data.category in [
              'UTILITY BILL',
              'WAGE',
              'SALARY',
              'RENT',
              'MAINTENANCE',
              'DELIVERY COMMISSION',
              'OTHER'
            ]
          )
        )
        && data.paymentMode in [
          'CASH',
          'PETTY_CASH',
          'CARD',
          'QR',
          'BANK',
          'BANK_TRANSFER',
          'CREDIT'
        ]
        && (
          (
            data.paymentMode == 'CREDIT'
            && data.entryType == 'purchase'
            && data.liabilityType == 'ACCOUNTS_PAYABLE'
          )
          || (
            data.paymentMode != 'CREDIT'
            && data.liabilityType == ''
          )
        );
    }

    /** Purchase/expense created from Collect → Pay delivery commission. */
    function isDeliveryCommissionPurchaseData(data) {
      return data.keys().hasAny(['source'])
        && data.source == 'delivery_boy_commission'
        && data.entryType == 'expense'
        && data.category == 'DELIVERY COMMISSION'
        && data.refType == 'delivery_boy_collection'
        && data.refId is string
        && data.refId.size() > 0
        && data.amount is number
        && data.amount > 0
        && data.partyId is string
        && data.partyId.size() > 0
        && data.vendorName is string
        && data.paymentMode in ['CASH', 'BANK']
        && data.liabilityType == ''
        && data.receiptNote is string
        && data.transactionId is string
        && data.transactionId.size() > 0
        && purchasePartyBelongsToClient(data.partyId, data.clientId)
        && (
          (
            data.paymentMode == 'CASH'
            && data.shiftId is string
            && data.shiftId.size() > 0
            && exists(/databases/$(database)/documents/shifts/$(data.shiftId))
            && get(/databases/$(database)/documents/shifts/$(data.shiftId)).data.clientId
              == data.clientId
            && get(/databases/$(database)/documents/shifts/$(data.shiftId)).data.status == 'OPEN'
          )
          || (
            data.paymentMode == 'BANK'
            && data.shiftId == ''
            && data.bankAccountId is string
            && data.bankAccountId.size() > 0
          )
        );
    }

    function deliveryCommissionPurchaseTxnMatches(data, purchaseId) {
      return getAfter(
          /databases/$(database)/documents/transactions/$(data.transactionId)
        ).data.clientId == data.clientId
        && getAfter(
          /databases/$(database)/documents/transactions/$(data.transactionId)
        ).data.type == 'expense'
        && getAfter(
          /databases/$(database)/documents/transactions/$(data.transactionId)
        ).data.source == 'delivery_boy_commission'
        && getAfter(
          /databases/$(database)/documents/transactions/$(data.transactionId)
        ).data.partyId == data.partyId
        && getAfter(
          /databases/$(database)/documents/transactions/$(data.transactionId)
        ).data.amountOut == data.amount
        && (
          (
            getAfter(
              /databases/$(database)/documents/transactions/$(data.transactionId)
            ).data.refType == 'purchase'
            && getAfter(
              /databases/$(database)/documents/transactions/$(data.transactionId)
            ).data.refId == purchaseId
          )
          || (
            getAfter(
              /databases/$(database)/documents/transactions/$(data.transactionId)
            ).data.refType == 'delivery_boy_collection'
            && getAfter(
              /databases/$(database)/documents/transactions/$(data.transactionId)
            ).data.refId == data.refId
          )
        );
    }

    match /users/{uid} {
      allow get: if activeUser() && (request.auth.uid == uid || isSuperAdmin());
      allow list, delete: if isSuperAdmin();

      // Super admin: full user management.
      // Shop admin: may create/update delivery_boy logins for their shops only.
      allow create: if isSuperAdmin()
        || (
          activeUser()
          && (profile().role == 'admin' || profile().role == 'shop_admin')
          && request.resource.data.role == 'delivery_boy'
          && request.resource.data.uid == uid
          && request.resource.data.email is string
          && request.resource.data.deliveryBoyId is string
          && request.resource.data.deliveryBoyId.size() > 0
          && request.resource.data.assignedShops is list
          && request.resource.data.assignedShops.size() == 1
          && assignedTo(request.resource.data.assignedShops[0])
          && request.resource.data.assignedTerminalIds is list
        );

      allow update: if isSuperAdmin()
        || (
          activeUser()
          && (profile().role == 'admin' || profile().role == 'shop_admin')
          && resource.data.role == 'delivery_boy'
          && request.resource.data.role == 'delivery_boy'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.deliveryBoyId == resource.data.deliveryBoyId
          && request.resource.data.assignedShops is list
          && request.resource.data.assignedShops.size() == 1
          && assignedTo(request.resource.data.assignedShops[0])
          && assignedTo(resource.data.assignedShops[0])
          && request.resource.data.assignedTerminalIds is list
        );
    }

    match /clients/{clientId} {
      allow read: if canAccessClient(clientId);
      allow create, update, delete: if isSuperAdmin();

      match /dailySessions/{sessionId} {
        allow read: if canAccessClient(clientId);
        allow create: if canAccessClient(clientId)
          && request.resource.data.clientId == clientId;
        allow update: if canAccessClient(clientId)
          && resource.data.clientId == clientId
          && request.resource.data.clientId == clientId;
        allow delete: if isSuperAdmin();
      }
    }

    match /client_settings/{clientId} {
      allow read: if canAccessClient(clientId);
      allow create: if canAccessClient(clientId)
        && request.resource.data.clientId == clientId
        && (
          !request.resource.data.keys().hasAny(['operationsShiftId'])
          || canManageClient(clientId)
        );
      allow update: if canAccessClient(clientId)
        && resource.data.clientId == clientId
        && request.resource.data.clientId == clientId
        && canChangeOperationsShiftId(clientId);
      allow delete: if isSuperAdmin();
    }

    match /parties/{partyId} {
      allow read: if canReadTenantResource();
      allow create: if canCreateTenantResource();
      allow update: if canUpdateTenantResource();
      allow delete: if canReadTenantResource();
    }

    match /bank_accounts/{accountId} {
      allow read: if canReadTenantResource();
      allow create: if canCreateTenantResource()
        && request.resource.data.accountName is string
        && request.resource.data.accountName.size() > 0
        && request.resource.data.bankName is string
        && request.resource.data.bankName.size() > 0
        && request.resource.data.accountNumber is string
        && request.resource.data.isActive is bool
        && (
          !('openingBalance' in request.resource.data)
          || (
            request.resource.data.openingBalance is number
            && request.resource.data.openingBalance >= 0
          )
        )
        && (
          !('accountType' in request.resource.data)
          || request.resource.data.accountType in ['OPERATIONAL', 'RESERVE']
        );
      allow update: if canUpdateTenantResource()
        && request.resource.data.accountName is string
        && request.resource.data.accountName.size() > 0
        && request.resource.data.bankName is string
        && request.resource.data.bankName.size() > 0
        && request.resource.data.accountNumber is string
        && request.resource.data.isActive is bool
        && (
          !('openingBalance' in request.resource.data)
          || (
            request.resource.data.openingBalance is number
            && request.resource.data.openingBalance >= 0
          )
        )
        && (
          !('accountType' in request.resource.data)
          || request.resource.data.accountType in ['OPERATIONAL', 'RESERVE']
        );
      allow delete: if canReadTenantResource();
    }

    match /transactions/{transactionId} {
      allow read: if canReadTenantResource();
      allow create: if canCreateTenantResource();
      allow update: if canUpdateTenantResource();
      allow delete: if canReadTenantResource();
    }

    match /inventory/{itemId} {
      // Staff may read catalog for checklist; only admin/super_admin mutate stock.
      allow read: if canReadTenantResource();
      allow create: if canManageClient(request.resource.data.clientId)
        && request.resource.data.keys().hasAll([
          'clientId',
          'category',
          'itemCode',
          'itemName',
          'cost',
          'sellingPrice',
          'imageUrl',
          'imagePath',
          'imageName',
          'imageStatus',
          'currentStock',
          'createdAt',
          'createdAtMs',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'clientId',
          'category',
          'itemCode',
          'itemName',
          'cost',
          'sellingPrice',
          'imageUrl',
          'imagePath',
          'imageName',
          'imageStatus',
          'currentStock',
          'createdAt',
          'createdAtMs',
          'createdBy',
          'updatedAt',
          'updatedBy',
          // Optional vertical extensions (retail / cafe / wholesale)
          'subCategory',
          'barcode',
          'minStock',
          'batchNo',
          'expiryDate',
          'baseUnit',
          'purchaseUnit',
          'subQty',
          'recipeNotes',
          'unitsPerCarton',
          'wholesalePrice',
          'directSale',
          'attentionLowQty',
          'attentionUrgentQty',
          'attentionVeryUrgentQty',
          // Shop-scoped numeric Item ID for CSV bulk edit
          'itemNo'
        ])
        && request.resource.data.category in [
          'COMMODITY',
          'CONSUMABLES',
          'ASSET'
        ]
        && (
          !('itemNo' in request.resource.data)
          || (
            request.resource.data.itemNo is int
            && request.resource.data.itemNo >= 1
          )
        )
        && request.resource.data.itemCode is string
        && request.resource.data.itemCode.size() > 0
        && request.resource.data.itemName is string
        && request.resource.data.itemName.size() > 0
        && request.resource.data.cost is number
        && request.resource.data.cost >= 0
        && request.resource.data.sellingPrice is number
        && request.resource.data.sellingPrice >= 0
        && request.resource.data.currentStock == 0
        && request.resource.data.imageStatus in ['NONE', 'UPLOADED']
        && (
          !('subCategory' in request.resource.data)
          || (
            request.resource.data.subCategory is string
            && request.resource.data.subCategory.size() <= 60
          )
        )
        && (
          !('attentionLowQty' in request.resource.data)
          || (
            request.resource.data.attentionLowQty is number
            && request.resource.data.attentionLowQty >= 0
          )
        )
        && (
          !('attentionUrgentQty' in request.resource.data)
          || (
            request.resource.data.attentionUrgentQty is number
            && request.resource.data.attentionUrgentQty >= 0
          )
        )
        && (
          !('attentionVeryUrgentQty' in request.resource.data)
          || (
            request.resource.data.attentionVeryUrgentQty is number
            && request.resource.data.attentionVeryUrgentQty >= 0
          )
        )
        && (
          !('barcode' in request.resource.data)
          || request.resource.data.barcode is string
        )
        && (
          !('minStock' in request.resource.data)
          || (
            request.resource.data.minStock is number
            && request.resource.data.minStock >= 0
          )
        )
        && (
          !('batchNo' in request.resource.data)
          || request.resource.data.batchNo is string
        )
        && (
          !('expiryDate' in request.resource.data)
          || request.resource.data.expiryDate is string
        )
        && (
          !('baseUnit' in request.resource.data)
          || request.resource.data.baseUnit is string
        )
        && (
          !('purchaseUnit' in request.resource.data)
          || (
            request.resource.data.purchaseUnit is string
            && request.resource.data.purchaseUnit.size() <= 40
          )
        )
        && (
          !('subQty' in request.resource.data)
          || (
            request.resource.data.subQty is number
            && request.resource.data.subQty >= 0
          )
        )
        && (
          !('recipeNotes' in request.resource.data)
          || request.resource.data.recipeNotes is string
        )
        && (
          !('unitsPerCarton' in request.resource.data)
          || (
            request.resource.data.unitsPerCarton is number
            && request.resource.data.unitsPerCarton >= 1
          )
        )
        && (
          !('wholesalePrice' in request.resource.data)
          || (
            request.resource.data.wholesalePrice is number
            && request.resource.data.wholesalePrice >= 0
          )
        )
        && (
          !('directSale' in request.resource.data)
          || request.resource.data.directSale is bool
        );
      allow update: if (
          canManageClient(resource.data.clientId)
          && request.resource.data.clientId == resource.data.clientId
        )
        || (
          // Staff may only reduce currentStock for daily usage (paired with STOCK_USAGE movement).
          isStaffForClient(resource.data.clientId)
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['currentStock', 'updatedAt', 'updatedBy'])
          && request.resource.data.currentStock is number
          && request.resource.data.currentStock >= 0
          && resource.data.currentStock is number
          && request.resource.data.currentStock < resource.data.currentStock
          && request.resource.data.updatedBy == request.auth.uid
        );
      allow delete: if canManageClient(resource.data.clientId);

      match /stock_audits/{auditId} {
        allow read: if canManageClient(
          get(/databases/$(database)/documents/inventory/$(itemId)).data.clientId
        );
        allow create: if canManageClient(
            get(/databases/$(database)/documents/inventory/$(itemId)).data.clientId
          )
          && request.resource.data.itemId == itemId;
        allow update: if canManageClient(
            get(/databases/$(database)/documents/inventory/$(itemId)).data.clientId
          )
          && request.resource.data.itemId == itemId;
        allow delete: if isSuperAdmin();
      }
    }

    function validStockUsageMovementCreate() {
      return request.resource.data.keys().hasAll([
          'clientId',
          'businessDate',
          'itemId',
          'itemCode',
          'itemName',
          'type',
          'qty',
          'unitCost',
          'amount',
          'oldStock',
          'totalStock',
          'source',
          'reason',
          'usageReason',
          'notes',
          'shiftId',
          'userId',
          'userName',
          'createdBy',
          'date',
          'dateMs',
          'createdAt'
        ])
        && request.resource.data.clientId is string
        && request.resource.data.businessDate is string
        && request.resource.data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.itemId is string
        && request.resource.data.itemId.size() > 0
        && request.resource.data.type == 'OUT'
        && request.resource.data.source == 'STOCK_USAGE'
        && request.resource.data.reason == 'USAGE'
        && request.resource.data.usageReason in [
          'DAILY_USE',
          'PRODUCTION',
          'WASTE',
          'SAMPLE',
          'OTHER'
        ]
        && request.resource.data.qty is number
        && request.resource.data.qty >= 0
        && request.resource.data.qty <= 1000000
        && request.resource.data.unitCost is number
        && request.resource.data.unitCost >= 0
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.oldStock is number
        && request.resource.data.totalStock is number
        && request.resource.data.totalStock >= 0
        && request.resource.data.totalStock
          == request.resource.data.oldStock - request.resource.data.qty
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.shiftId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.dateMs is number;
    }

    match /inventory_movements/{movementId} {
      // resource == null: allow transactional probe for idempotent offline usage sync
      // (movement id = entryLocalId before the doc is created).
      allow get: if activeUser()
        && (
          resource == null
          || (
            canAccessClient(resource.data.clientId)
            && (
              !isStaff()
              || (
                resource.data.source == 'STOCK_USAGE'
                && canReviewInventoryDaily(resource.data.clientId)
              )
            )
          )
        );
      // Staff may only list STOCK_USAGE rows for their shop (Today's usage query).
      allow list: if activeUser()
        && (
          (
            !isStaff()
            && canAccessClient(resource.data.clientId)
          )
          || (
            isStaff()
            && resource.data.source == 'STOCK_USAGE'
            && canReviewInventoryDaily(resource.data.clientId)
          )
        );
      allow create: if canManageClient(request.resource.data.clientId)
        || (
          canReviewInventoryDaily(request.resource.data.clientId)
          && validStockUsageMovementCreate()
        );
      allow update: if canManageClient(resource.data.clientId)
        && request.resource.data.clientId == resource.data.clientId;
      allow delete: if isSuperAdmin();
    }

    match /inventory_daily_reviews/{reviewId} {
      // resource == null: allow transactional get/create of today's review doc.
      allow get: if activeUser()
        && (
          resource == null
          || canReviewInventoryDaily(resource.data.clientId)
        );
      allow list: if canReviewInventoryDaily(resource.data.clientId);
      allow create: if canReviewInventoryDaily(request.resource.data.clientId)
        && reviewId == request.resource.data.clientId + '_' + request.resource.data.businessDate
        && validDailyReviewParentCreate();
      allow update: if canReviewInventoryDaily(resource.data.clientId)
        && validDailyReviewParentUpdate();
      allow delete: if isSuperAdmin();

      match /lines/{lineId} {
        allow get: if activeUser()
          && (
            resource == null
            || canReviewInventoryDaily(resource.data.clientId)
          );
        // Queries must filter clientId == assigned shop (see subscribeDailyReviewLines).
        allow list: if canReviewInventoryDaily(resource.data.clientId);
        allow create: if canReviewInventoryDaily(request.resource.data.clientId)
          && request.resource.data.clientId is string
          && request.resource.data.businessDate is string
          && reviewId == request.resource.data.clientId + '_' + request.resource.data.businessDate
          && validDailyReviewLineWrite(
            request.resource.data.clientId,
            request.resource.data.businessDate,
            lineId
          )
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAtMs is number;
        allow update: if canReviewInventoryDaily(resource.data.clientId)
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.businessDate == resource.data.businessDate
          && request.resource.data.itemId == resource.data.itemId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAtMs == resource.data.createdAtMs
          && validDailyReviewLineWrite(
            resource.data.clientId,
            resource.data.businessDate,
            lineId
          );
        allow delete: if isSuperAdmin();
      }
    }

    match /payment_receipts/{entryId} {
      allow read: if canReadTenantResource();

      allow create: if canCreateTenantResource()
        && request.resource.data.entryType in ['receipt', 'payment']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.partyId is string
        && request.resource.data.partyName is string
        && request.resource.data.category in [
          'SETTLEMENT',
          'ADVANCE',
          'LOAN',
          'OTHER'
        ]
        && request.resource.data.paymentMode in [
          'CASH',
          'PETTY_CASH',
          'CARD',
          'QR',
          'BANK',
          'BANK_TRANSFER'
        ]
        && request.resource.data.note is string
        && request.resource.data.transactionId is string
        && request.resource.data.createdBy == request.auth.uid
        && get(
          /databases/$(database)/documents/parties/$(request.resource.data.partyId)
        ).data.clientId == request.resource.data.clientId
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.clientId == request.resource.data.clientId
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.type == request.resource.data.entryType
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.partyId == request.resource.data.partyId
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.refType == 'payment_receipt'
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.refId == entryId
        && (
          (
            request.resource.data.paymentMode == 'CASH'
            && request.resource.data.shiftId is string
            && get(
              /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
            ).data.clientId == request.resource.data.clientId
            && get(
              /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
            ).data.status == 'OPEN'
          )
          || (
            request.resource.data.paymentMode != 'CASH'
            && request.resource.data.shiftId == ''
          )
        );

      allow update: if canUpdateTenantResource()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'entryType',
          'amount',
          'partyId',
          'partyName',
          'category',
          'paymentMode',
          'bankAccountId',
          'bankAccountName',
          'liabilityType',
          'note',
          'shiftId',
          'businessDate',
          'businessDateAt',
          'updatedBy',
          'updatedAt',
          'updatedAtMs'
        ])
        && request.resource.data.transactionId == resource.data.transactionId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.entryType in ['receipt', 'payment']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.partyId is string
        && request.resource.data.partyName is string
        && request.resource.data.category in [
          'SETTLEMENT',
          'ADVANCE',
          'LOAN',
          'OTHER'
        ]
        && request.resource.data.paymentMode in [
          'CASH',
          'PETTY_CASH',
          'CARD',
          'QR',
          'BANK',
          'BANK_TRANSFER'
        ]
        && request.resource.data.note is string
        && get(
          /databases/$(database)/documents/parties/$(request.resource.data.partyId)
        ).data.clientId == request.resource.data.clientId
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.clientId == request.resource.data.clientId
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.type == request.resource.data.entryType
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.partyId == request.resource.data.partyId
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.refType == 'payment_receipt'
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.refId == entryId
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.totalAmount == request.resource.data.amount
        && (
          (
            request.resource.data.paymentMode == 'CASH'
            && request.resource.data.shiftId is string
            && get(
              /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
            ).data.clientId == request.resource.data.clientId
            && (
              request.resource.data.shiftId == resource.data.shiftId
              || get(
                /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
              ).data.status == 'OPEN'
            )
          )
          || (
            request.resource.data.paymentMode != 'CASH'
            && request.resource.data.shiftId == ''
          )
        );

      allow delete: if isSuperAdmin();
    }

    match /internal_transfers/{transferId} {
      allow read: if canReadTenantResource();

      allow create: if canCreateTenantResource()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.transferType in ['CASH_TO_BANK', 'BANK_TO_CASH', 'BANK_TO_BANK', 'CASH_TO_PETTI', 'PETTI_TO_CASH', 'BANK_TO_PETTI', 'PETTI_TO_BANK', 'CASH_TO_LOCKER', 'LOCKER_TO_CASH']
        && request.resource.data.note is string
        && request.resource.data.businessDate is string
        && request.resource.data.shiftId is string
        && request.resource.data.transactionId is string
        && request.resource.data.createdBy == request.auth.uid
        && get(
          /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
        ).data.clientId == request.resource.data.clientId
        && get(
          /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
        ).data.status == 'OPEN'
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.clientId == request.resource.data.clientId
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.type == 'transfer'
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.internalTransfer == true
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.refType == 'internal_transfer'
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.refId == transferId
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.transferType == request.resource.data.transferType;

      allow update: if canUpdateTenantResource()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'transferType',
          'amount',
          'note',
          'bankAccountId',
          'bankAccountName',
          'destinationBankAccountId',
          'destinationBankAccountName',
          'paymentMode',
          'businessDate',
          'businessDateAt',
          'shiftId',
          'updatedBy',
          'updatedAt',
          'updatedAtMs'
        ])
        && request.resource.data.transactionId == resource.data.transactionId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.transferType in ['CASH_TO_BANK', 'BANK_TO_CASH', 'BANK_TO_BANK', 'CASH_TO_PETTI', 'PETTI_TO_CASH', 'BANK_TO_PETTI', 'PETTI_TO_BANK', 'CASH_TO_LOCKER', 'LOCKER_TO_CASH']
        && request.resource.data.note is string
        && request.resource.data.businessDate is string
        && request.resource.data.shiftId is string
        && get(
          /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
        ).data.clientId == request.resource.data.clientId
        && (
          request.resource.data.shiftId == resource.data.shiftId
          || get(
            /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
          ).data.status == 'OPEN'
        )
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.clientId == request.resource.data.clientId
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.type == 'transfer'
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.internalTransfer == true
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.refType == 'internal_transfer'
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.refId == transferId
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.transferType == request.resource.data.transferType
        && getAfter(
          /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
        ).data.totalAmount == request.resource.data.amount;

      allow delete: if isSuperAdmin();
    }

    match /purchase_orders/{poId} {
      allow read: if canReadTenantResource();

      allow create: if canManageClient(request.resource.data.clientId)
        && request.resource.data.clientId is string
        && request.resource.data.businessDate is string
        && request.resource.data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.poNumber is string
        && request.resource.data.poNumber.size() > 0
        && request.resource.data.poNumber.size() <= 40
        && request.resource.data.vendorId is string
        && request.resource.data.vendorId.size() > 0
        && request.resource.data.vendorName is string
        && request.resource.data.vendorName.size() > 0
        && request.resource.data.vendorPhone is string
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() <= 200
        && request.resource.data.lineCount is number
        && request.resource.data.lineCount == request.resource.data.lines.size()
        && request.resource.data.status in ['DRAFT', 'SENT', 'PARTIALLY_RECEIVED', 'COMPLETED', 'CANCELLED']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAtMs is number
        && request.resource.data.updatedAtMs is number;

      allow update: if canManageClient(resource.data.clientId)
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.poNumber == resource.data.poNumber
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.businessDate is string
        && request.resource.data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.vendorId is string
        && request.resource.data.vendorId.size() > 0
        && request.resource.data.vendorName is string
        && request.resource.data.vendorName.size() > 0
        && request.resource.data.vendorPhone is string
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() <= 200
        && request.resource.data.lineCount is number
        && request.resource.data.lineCount == request.resource.data.lines.size()
        && request.resource.data.status in ['DRAFT', 'SENT', 'PARTIALLY_RECEIVED', 'COMPLETED', 'CANCELLED']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAtMs is number;

      allow delete: if isSuperAdmin();
    }

    match /purchases/{purchaseId} {
      allow read: if canReadTenantResource();

      allow create: if canCreateTenantResource()
        && (
          // Delivery commission expense from Collect (party = delivery_boys doc).
          (
            canManageClient(request.resource.data.clientId)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.updatedBy == request.auth.uid
            && isDeliveryCommissionPurchaseData(request.resource.data)
            && deliveryCommissionPurchaseTxnMatches(request.resource.data, purchaseId)
          )
          || (
            request.resource.data.amount is number
            && request.resource.data.amount > 0
            && request.resource.data.partyId is string
            && request.resource.data.vendorName is string
            && request.resource.data.entryType in ['purchase', 'expense']
            && (
              (
                request.resource.data.entryType == 'purchase'
                && request.resource.data.category in [
                  'COMMODITY',
                  'CONSUMABLES',
                  'ASSET'
                ]
              )
              || (
                request.resource.data.entryType == 'expense'
                && request.resource.data.category in [
                  'UTILITY BILL',
                  'WAGE',
                  'SALARY',
                  'RENT',
                  'MAINTENANCE',
                  'DELIVERY COMMISSION',
                  'OTHER'
                ]
              )
            )
            && request.resource.data.paymentMode in [
              'CASH',
              'PETTY_CASH',
              'CARD',
              'QR',
              'BANK',
              'BANK_TRANSFER',
              'CREDIT'
            ]
            && request.resource.data.receiptNote is string
            && request.resource.data.transactionId is string
            && request.resource.data.createdBy == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
            ).data.clientId == request.resource.data.clientId
            && getAfter(
              /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
            ).data.refType == 'purchase'
            && getAfter(
              /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
            ).data.refId == purchaseId
            && getAfter(
              /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
            ).data.partyId == request.resource.data.partyId
            && getAfter(
              /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
            ).data.type == request.resource.data.entryType
            && (
              (
                request.resource.data.paymentMode == 'CREDIT'
                && request.resource.data.entryType == 'purchase'
                && request.resource.data.liabilityType == 'ACCOUNTS_PAYABLE'
                && getAfter(
                  /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
                ).data.mode == 'credit'
                && getAfter(
                  /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
                ).data.amountOut == request.resource.data.amount
                && getAfter(
                  /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
                ).data.liabilityType == 'ACCOUNTS_PAYABLE'
              )
              || (
                request.resource.data.paymentMode != 'CREDIT'
                && request.resource.data.liabilityType == ''
              )
            )
            && purchasePartyBelongsToClient(
              request.resource.data.partyId,
              request.resource.data.clientId
            )
            && (
              (
                request.resource.data.paymentMode == 'CASH'
                && request.resource.data.shiftId is string
                && get(
                  /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
                ).data.clientId == request.resource.data.clientId
                && get(
                  /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
                ).data.status == 'OPEN'
              )
              || (
                request.resource.data.paymentMode != 'CASH'
                && request.resource.data.shiftId == ''
              )
            )
          )
        );

      allow update: if canUpdateTenantResource()
        && (
          (
            canManageClient(request.resource.data.clientId)
            && resource.data.source == 'delivery_boy_commission'
            && request.resource.data.source == 'delivery_boy_commission'
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.transactionId == resource.data.transactionId
            && request.resource.data.updatedBy == request.auth.uid
            && isDeliveryCommissionPurchaseData(request.resource.data)
            && deliveryCommissionPurchaseTxnMatches(request.resource.data, purchaseId)
          )
          || (
            validPurchaseValues(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'entryType',
              'amount',
              'partyId',
              'vendorName',
              'category',
              'paymentMode',
              'bankAccountId',
              'bankAccountName',
              'liabilityType',
              'receiptNote',
              'shiftId',
              'businessDate',
              'businessDateAt',
              'updatedBy',
              'updatedAt',
              'updatedAtMs'
            ])
            && request.resource.data.transactionId == resource.data.transactionId
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.updatedBy == request.auth.uid
            && purchasePartyBelongsToClient(
              request.resource.data.partyId,
              request.resource.data.clientId
            )
            && getAfter(
              /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
            ).data.clientId == request.resource.data.clientId
            && getAfter(
              /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
            ).data.refType == 'purchase'
            && getAfter(
              /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
            ).data.refId == purchaseId
            && getAfter(
              /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
            ).data.partyId == request.resource.data.partyId
            && getAfter(
              /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
            ).data.type == request.resource.data.entryType
            && getAfter(
              /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
            ).data.amountOut == request.resource.data.amount
            && getAfter(
              /databases/$(database)/documents/transactions/$(request.resource.data.transactionId)
            ).data.liabilityType == request.resource.data.liabilityType
            && (
              (
                request.resource.data.paymentMode == 'CASH'
                && request.resource.data.shiftId is string
                && get(
                  /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
                ).data.clientId == request.resource.data.clientId
                && (
                  request.resource.data.shiftId == resource.data.shiftId
                  || get(
                    /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
                  ).data.status == 'OPEN'
                )
              )
              || (
                request.resource.data.paymentMode != 'CASH'
                && request.resource.data.shiftId == ''
              )
            )
          )
        );

      // Super admin, or shop managers removing a Collect commission expense.
      allow delete: if isSuperAdmin()
        || (
          canManageClient(resource.data.clientId)
          && resource.data.source == 'delivery_boy_commission'
        );
    }

    match /sales_invoices/{invoiceId} {
      allow read: if canReadTenantResource();
      allow create: if canCreateTenantResource();
      allow update: if canUpdateTenantResource();
      allow delete: if isSuperAdmin();

      match /items/{itemId} {
        allow read: if canReadTenantResource();
        allow create: if canCreateTenantResource()
          && request.resource.data.invoiceId == invoiceId;
        allow update: if canUpdateTenantResource()
          && request.resource.data.invoiceId == invoiceId;
        allow delete: if canReadTenantResource();
      }
    }

    match /daily_reports/{reportId} {
      allow read: if canReadTenantResource();

      allow create: if canCreateTenantResource()
        && canManageClient(request.resource.data.clientId)
        && request.resource.data.date is string
        && request.resource.data.totalSales is number
        && request.resource.data.totalExpenses is number
        && request.resource.data.expectedCash is number
        && request.resource.data.actualCash is number
        && request.resource.data.cashVariance is number
        && request.resource.data.totalBank is number
        && request.resource.data.totalReceivable is number
        && request.resource.data.totalPayable is number
        && request.resource.data.status == 'closed'
        && request.resource.data.isEdited == false
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if canUpdateTenantResource()
        && canManageClient(resource.data.clientId)
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.date == resource.data.date
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.status in ['closed', 're-opened']
        && request.resource.data.isEdited is bool
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isSuperAdmin();
    }

    match /shift_date_locks/{lockId} {
      // Allow get of missing docs (resource == null) so open-shift transactions can
      // probe a lock id before create. Existing docs require shop access.
      allow get: if activeUser()
        && (
          resource == null
          || canAccessClient(resource.data.clientId)
        );
      allow list: if false;

      allow create: if canManageClient(request.resource.data.clientId)
        && request.resource.data.clientId is string
        && request.resource.data.businessDate is string
        && request.resource.data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.shiftId is string
        && request.resource.data.shiftId.size() > 0
        && lockId == request.resource.data.clientId + '_' + request.resource.data.businessDate
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if canManageClient(resource.data.clientId)
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.businessDate == resource.data.businessDate
        && request.resource.data.shiftId is string
        && request.resource.data.shiftId.size() > 0
        && lockId == resource.data.clientId + '_' + resource.data.businessDate;

      allow delete: if resource != null && canManageClient(resource.data.clientId);
    }

    match /shifts/{shiftId} {
      allow read: if canReadTenantResource();

      allow create: if canManageClient(request.resource.data.clientId)
        && request.resource.data.openedBy == request.auth.uid
        && request.resource.data.status == 'OPEN'
        && request.resource.data.zReportId == null
        && request.resource.data.businessDate is string
        && request.resource.data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.openedByRole is string
        && (
          !isShopAdmin()
          || (
            request.resource.data.operationsBoundBy == request.auth.uid
            && request.resource.data.operationsBoundByRole == 'shop_admin'
          )
        );

      allow update: if canManageClient(resource.data.clientId)
        && request.resource.data.openedBy == resource.data.openedBy
        && request.resource.data.clientId == resource.data.clientId
        && shiftBusinessDateChangeAllowed(shiftId, resource.data.clientId)
        && shopAdminShiftDateImmutable()
        && (
          (
            resource.data.status == 'OPEN'
            && request.resource.data.status in ['OPEN', 'CLOSED']
            && (
              request.resource.data.status == 'OPEN'
              || (
                request.resource.data.closedBy == request.auth.uid
                && request.resource.data.zReportId is string
                && getAfter(
                  /databases/$(database)/documents/z_reports/$(request.resource.data.zReportId)
                ).data.shiftId == shiftId
              )
              || (
                request.resource.data.closedBy == request.auth.uid
                && request.resource.data.zReportId == null
                && request.resource.data.closedWithoutZReport == true
              )
            )
          )
          || (
            resource.data.status == 'CLOSED'
            && request.resource.data.status == 'CLOSED'
            && request.resource.data.zReportId == resource.data.zReportId
            && request.resource.data.closedBy == resource.data.closedBy
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'openingFloat',
              'closingCashCounted',
              'updatedBy',
              'updatedAt'
            ])
            && request.resource.data.updatedBy == request.auth.uid
          )
        );

      allow delete: if isSuperAdmin();
    }

    match /z_reports/{reportId} {
      allow read: if canReadTenantResource();

      allow create: if canCreateTenantResource()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.shiftId is string
        && request.resource.data.grossSales is number
        && request.resource.data.grossSales >= 0
        && request.resource.data.netSales is number
        && request.resource.data.netSales >= 0
        && request.resource.data.openingFloat is number
        && request.resource.data.openingFloat >= 0
        && request.resource.data.creditSalesTotal is number
        && request.resource.data.creditSalesTotal >= 0
        && request.resource.data.creditEntries is list
        && request.resource.data.creditEntries.size() <= 100
        && request.resource.data.bankEntries is list
        && request.resource.data.bankEntries.size() <= 100
        && request.resource.data.cashEntries is list
        && request.resource.data.cashEntries.size() <= 100
        && !request.resource.data.keys().hasAny(['voidTotal'])
        && get(
          /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
        ).data.clientId == request.resource.data.clientId
        && (
          // Save Z-report while shift remains OPEN (global shift bar closes separately).
          (
            get(
              /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
            ).data.status == 'OPEN'
            && request.resource.data.shiftStatus == 'OPEN'
          )
          // Legacy: create Z-report in the same transaction that closes the shift.
          || getAfter(
            /databases/$(database)/documents/shifts/$(request.resource.data.shiftId)
          ).data.zReportId == reportId
        );

      allow update: if canUpdateTenantResource()
        && request.resource.data.shiftId == resource.data.shiftId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.grossSales is number
        && request.resource.data.grossSales >= 0
        && request.resource.data.netSales is number
        && request.resource.data.netSales >= 0
        && request.resource.data.openingFloat is number
        && request.resource.data.openingFloat >= 0
        && request.resource.data.creditSalesTotal is number
        && request.resource.data.creditSalesTotal >= 0
        && request.resource.data.creditEntries is list
        && request.resource.data.creditEntries.size() <= 100
        && request.resource.data.bankEntries is list
        && request.resource.data.bankEntries.size() <= 100
        && request.resource.data.cashEntries is list
        && request.resource.data.cashEntries.size() <= 100
        && !request.resource.data.keys().hasAny(['voidTotal']);

      allow delete: if isSuperAdmin();
    }

    // External Sales / Sales Bill Entry masters + bills (additive; not POS sales)
    function validExternalMasterWrite() {
      return request.resource.data.clientId is string
        && canManageClient(request.resource.data.clientId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.isActive is bool
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validDeliveryBoyWrite() {
      return validExternalMasterWrite()
        && request.resource.data.commissionEnabled is bool
        && request.resource.data.commissionRate is number
        && request.resource.data.commissionRate >= 0
        && request.resource.data.commissionRate <= 100
        && (
          request.resource.data.commissionEnabled == false
          || request.resource.data.commissionRate >= 0
        );
    }

    function validExternalBillPayment() {
      return request.resource.data.bankAccountId is string
        && request.resource.data.bankAccountNameSnapshot is string
        && request.resource.data.customerId is string
        && request.resource.data.customerName is string
        && (
          // Default delivery settlement: on delivery boy's account
          (
            request.resource.data.saleType == 'DELIVERY'
            && request.resource.data.paymentMode == 'DELIVERY_ACCOUNT'
            && request.resource.data.bankAccountId == ''
          )
          // Delivery paid directly to shop, or non-delivery tender
          || (
            request.resource.data.paymentMode == 'CASH'
            && request.resource.data.bankAccountId == ''
          )
          || (
            request.resource.data.paymentMode == 'BANK'
            && request.resource.data.bankAccountId.size() > 0
            && request.resource.data.bankAccountNameSnapshot.size() > 0
          )
          || (
            request.resource.data.paymentMode == 'CREDIT'
            && request.resource.data.customerId.size() > 0
            && request.resource.data.customerName.size() > 0
            && request.resource.data.bankAccountId == ''
          )
          // Cash + bank on one bill
          || (
            request.resource.data.paymentMode == 'SPLIT'
            && request.resource.data.paidCash is number
            && request.resource.data.paidBank is number
            && request.resource.data.paidCash > 0
            && request.resource.data.paidBank > 0
            && request.resource.data.paidCash + request.resource.data.paidBank
              == request.resource.data.billAmount
            && request.resource.data.bankAccountId.size() > 0
            && request.resource.data.bankAccountNameSnapshot.size() > 0
            && request.resource.data.customerId == ''
          )
        );
    }

    function validExternalBillFields() {
      return request.resource.data.businessDate is string
        && request.resource.data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.terminalId is string
        && request.resource.data.terminalId.size() > 0
        && request.resource.data.terminalNameSnapshot is string
        && request.resource.data.billNumber is string
        && request.resource.data.billNumber.size() > 0
        && request.resource.data.billNumber.size() <= 40
        && request.resource.data.billAmount is number
        // Negative allowed for cash returns (bank overpay returned as cash).
        && request.resource.data.saleType in ['DELIVERY', 'DINE_IN', 'PICK_UP']
        && request.resource.data.deliveryCharge is number
        && request.resource.data.deliveryCharge >= 0
        && request.resource.data.commissionEnabled is bool
        && request.resource.data.commissionRate is number
        && request.resource.data.commissionRate >= 0
        && request.resource.data.commissionAmount is number
        && request.resource.data.commissionAmount >= 0
        && request.resource.data.salesSource == 'EXTERNAL_BILL_ENTRY'
        && request.resource.data.voided == false
        && validExternalBillPayment()
        && externalBillBankIsOperational()
        && (
          request.resource.data.saleType != 'DELIVERY'
          || (
            request.resource.data.deliveryBoyId is string
            && request.resource.data.deliveryBoyId.size() > 0
          )
        )
        && (
          // Manual Analytics entry may omit entryLocalId (legacy + admin UI).
          !('entryLocalId' in request.resource.data)
          || request.resource.data.entryLocalId is string
        )
        && (
          request.resource.data.entrySource == 'MANUAL'
          || request.resource.data.entrySource == 'DELIVERY_APP'
          || !('entrySource' in request.resource.data)
        );
    }

    function validExternalBillCreate() {
      return request.resource.data.clientId is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && validExternalBillFields()
        // Only shop admins create live bills (incl. approving Delivery Entry).
        && canManageClient(request.resource.data.clientId);
    }

    function validExternalBillEdit() {
      return resource.data.voided == false
        && request.resource.data.voided == false
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.businessDate == resource.data.businessDate
        && request.resource.data.terminalId == resource.data.terminalId
        && request.resource.data.billNumber == resource.data.billNumber
        && request.resource.data.salesSource == resource.data.salesSource
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && validExternalBillFields();
    }

    match /billing_terminals/{terminalId} {
      allow read: if canReadTenantResource();
      allow create: if validExternalMasterWrite()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if canManageClient(resource.data.clientId)
        && request.resource.data.clientId == resource.data.clientId
        && validExternalMasterWrite();
      allow delete: if isSuperAdmin();
    }

    match /delivery_boys/{boyId} {
      allow read: if canReadTenantResource();
      allow create: if validDeliveryBoyWrite()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if canManageClient(resource.data.clientId)
        && request.resource.data.clientId == resource.data.clientId
        && (
          // Full edit (name / commission / active)
          validDeliveryBoyWrite()
          // Activate / deactivate only (legacy docs without commission fields)
          || (
            request.resource.data.name == resource.data.name
            && request.resource.data.isActive is bool
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.clientId == resource.data.clientId
          )
        );
      allow delete: if isSuperAdmin();
    }

    function collectionPaysCommission() {
      return request.resource.data.keys().hasAny(['commissionPaid'])
        && request.resource.data.commissionPaid == true
        && request.resource.data.commissionPaidAmount is number
        && request.resource.data.commissionPaidAmount > 0
        && request.resource.data.commissionPaidMode in ['CASH', 'BANK']
        && (
          request.resource.data.commissionPaidMode == 'CASH'
          || (
            request.resource.data.commissionPaidBankAccountId is string
            && request.resource.data.commissionPaidBankAccountId.size() > 0
          )
        );
    }

    function validDeliveryBoyCollectionFields() {
      return request.resource.data.businessDate is string
        && request.resource.data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.deliveryBoyId is string
        && request.resource.data.deliveryBoyId.size() > 0
        && request.resource.data.deliveryBoyNameSnapshot is string
        && request.resource.data.payableAmount is number
        && request.resource.data.payableAmount >= 0
        && request.resource.data.paidCash is number
        && request.resource.data.paidCash >= 0
        && request.resource.data.paidBank is number
        && request.resource.data.paidBank >= 0
        && request.resource.data.balanceAmount is number
        && request.resource.data.balanceAmount >= 0
        && request.resource.data.bankAccountId is string
        && request.resource.data.bankAccountNameSnapshot is string
        // Collect cash/bank, or commission-only pay on an already-settled day.
        && (
          (request.resource.data.paidCash + request.resource.data.paidBank) > 0
          || collectionPaysCommission()
        )
        && (request.resource.data.paidCash + request.resource.data.paidBank)
          <= request.resource.data.payableAmount
        && (
          request.resource.data.paidBank == 0
          || (
            request.resource.data.bankAccountId.size() > 0
            && request.resource.data.bankAccountNameSnapshot.size() > 0
          )
        );
    }

    match /delivery_boy_collections/{collectionId} {
      // Shop staff: any collection for assigned shops.
      // Delivery boys: only their own collection rows (for balance on Approved).
      allow get: if canReadTenantResource()
        || (
          isDeliveryBoyForClient(resource.data.clientId)
          && resource.data.deliveryBoyId == profile().deliveryBoyId
        );
      allow list: if resource != null
        && (
          canReadTenantResource()
          || (
            isDeliveryBoyForClient(resource.data.clientId)
            && resource.data.deliveryBoyId == profile().deliveryBoyId
          )
        );
      allow create: if request.resource.data.clientId is string
        && canManageClient(request.resource.data.clientId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && validDeliveryBoyCollectionFields();
      allow update: if canManageClient(resource.data.clientId)
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.businessDate == resource.data.businessDate
        && request.resource.data.deliveryBoyId == resource.data.deliveryBoyId
        && validDeliveryBoyCollectionFields();
      allow delete: if isSuperAdmin();
    }

    match /delivery_bill_submissions/{submissionId} {
      // get on a missing doc (idempotent create) has resource == null.
      allow get: if isDeliveryBoy()
        || (
          resource != null
          && (
            canReadTenantResource()
            || (
              isDeliveryBoyForClient(resource.data.clientId)
              && resource.data.deliveryBoyId == profile().deliveryBoyId
            )
          )
        );

      // List queries must include clientId (admins) or clientId+deliveryBoyId (boys).
      allow list: if resource != null
        && (
          canReadTenantResource()
          || (
            isDeliveryBoyForClient(resource.data.clientId)
            && resource.data.deliveryBoyId == profile().deliveryBoyId
          )
        );

      allow create: if request.resource.data.clientId is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && validDeliveryBillSubmissionFields()
        && (
          canManageClient(request.resource.data.clientId)
          || deliveryBoyOwnsSubmission()
        );

      allow update: if deliveryBoyMayEditOwnSubmission()
        || (
          canManageClient(resource.data.clientId)
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.entryLocalId == resource.data.entryLocalId
          && request.resource.data.businessDate == resource.data.businessDate
          && request.resource.data.terminalId == resource.data.terminalId
          && request.resource.data.billNumber == resource.data.billNumber
          && resource.data.status in ['PENDING', 'EDITED_PENDING']
          && request.resource.data.status in ['APPROVED', 'REJECTED']
          && validDeliveryBillSubmissionFields()
        );

      allow delete: if isSuperAdmin();
    }

    match /external_sales_bills/{billId} {
      // Shop staff: any bill for assigned shops.
      // Delivery boys: only bills entered/approved in their name (shop or Delivery Entry).
      // resource == null: bill save runs tx.get on the deterministic id before create.
      allow get: if activeUser()
        && (
          resource == null
          || canReadTenantResource()
          || (
            isDeliveryBoyForClient(resource.data.clientId)
            && resource.data.deliveryBoyId == profile().deliveryBoyId
          )
        );
      allow list: if resource != null
        && (
          canReadTenantResource()
          || (
            isDeliveryBoyForClient(resource.data.clientId)
            && resource.data.deliveryBoyId == profile().deliveryBoyId
          )
        );
      allow create: if validExternalBillCreate();
      allow update: if canManageClient(resource.data.clientId)
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.updatedBy == request.auth.uid
        && (
          // Soft-void only (preserve identity keys)
          (
            resource.data.voided == false
            && request.resource.data.voided == true
            && request.resource.data.businessDate == resource.data.businessDate
            && request.resource.data.terminalId == resource.data.terminalId
            && request.resource.data.billNumber == resource.data.billNumber
            && request.resource.data.billAmount == resource.data.billAmount
            && request.resource.data.saleType == resource.data.saleType
            && request.resource.data.deliveryCharge == resource.data.deliveryCharge
            && request.resource.data.commissionAmount == resource.data.commissionAmount
            && request.resource.data.commissionRate == resource.data.commissionRate
            && request.resource.data.commissionEnabled == resource.data.commissionEnabled
            && request.resource.data.salesSource == resource.data.salesSource
            && request.resource.data.createdBy == resource.data.createdBy
          )
          // Edit an existing active bill (same shop/date/terminal/bill number)
          || validExternalBillEdit()
          // Re-enter a previously voided bill number (same deterministic id)
          || (
            resource.data.voided == true
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.businessDate == resource.data.businessDate
            && request.resource.data.terminalId == resource.data.terminalId
            && request.resource.data.billNumber == resource.data.billNumber
            && validExternalBillFields()
          )
        );
      allow delete: if isSuperAdmin();
    }

    function validExternalTerminalBillRangeFields() {
      return request.resource.data.businessDate is string
        && request.resource.data.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.terminalId is string
        && request.resource.data.terminalId.size() > 0
        && request.resource.data.terminalNameSnapshot is string
        && request.resource.data.startBillNumber is string
        && request.resource.data.startBillNumber.matches('^[0-9]+$')
        && request.resource.data.endBillNumber is string
        && request.resource.data.endBillNumber.matches('^[0-9]+$')
        && request.resource.data.startSeq is number
        && request.resource.data.endSeq is number
        && request.resource.data.startSeq >= 0
        && request.resource.data.endSeq >= request.resource.data.startSeq
        && request.resource.data.endSeq - request.resource.data.startSeq < 5000;
    }

    match /external_terminal_bill_ranges/{rangeId} {
      allow read: if canReadTenantResource();
      allow create: if request.resource.data.clientId is string
        && canManageClient(request.resource.data.clientId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && validExternalTerminalBillRangeFields();
      allow update: if canManageClient(resource.data.clientId)
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.businessDate == resource.data.businessDate
        && request.resource.data.terminalId == resource.data.terminalId
        && validExternalTerminalBillRangeFields();
      allow delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
